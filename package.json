{
  "name": "sightline-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The sightline web client: ask a question of your data, revise it by prompt, see the chart.",
  "scripts": {
    "dev": "vite",
    "dev:mock": "node scripts/dev-mock.mjs",
    "mock": "node mock/server.ts",
    "gen:api": "node scripts/gen-api.mjs",
    "fixtures": "node scripts/export-fixtures.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@microsoft/fetch-event-source": "2.0.1",
    "@tanstack/react-query": "5.104.5",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.13.0",
    "vega": "5.33.1",
    "vega-embed": "6.29.0",
    "vega-lite": "5.23.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
