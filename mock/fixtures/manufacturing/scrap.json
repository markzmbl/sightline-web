  "result": {
    "sql": "SELECT \"f\".\"production_order\" AS \"production_order\", ((COALESCE(SUM(\"f\".\"scrap_qty\"), 0)) / NULLIF((COALESCE(SUM(\"f\".\"planned_scrap_qty\"), 0)), 0)) AS \"actual_to_planned_scrap\" FROM \"main\".\"fct_production_shifts\" AS \"f\" WHERE \"f\".\"shift_date\" >= CAST('2025-01-01' AS DATE) AND \"f\".\"shift_date\" <= CAST('2025-12-31' AS DATE) GROUP BY \"f\".\"production_order\" HAVING (COUNT(*) + COUNT(*)) > 0 ORDER BY \"actual_to_planned_scrap\" DESC LIMIT 10",
    "step_id": "st1",
    "columns": [
