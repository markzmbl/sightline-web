  "restatement": "You want to see the top line by kWh per 1,000 good units.",
  "definitions": [
    {
      "name": "energy per good unit",
      "label": "Energy per 1,000 good units",
      "definition": "1,000 times the energy used (energy kWh) over the good quantity (good units)",
      "entry_id": "measure-energy-per-good-unit",
      "source": {
        "kind": "question",
        "text": "as the question states it"
      },
      "status": "proposed"
    }
  ],
  "card": null,
  "clarify": null,
  "follow_ups": [],
  "error": null,
  "result": {
    "sql": "SELECT \"dim_line\".\"line_name\" AS \"line_name\", (1000.0 * (COALESCE(SUM(\"f\".\"energy_kwh\"), 0)) / NULLIF((COALESCE(SUM(\"f\".\"good_qty\"), 0)), 0)) AS \"energy_per_thousand_good_units\" FROM \"main\".\"mart_line_performance_month\" AS \"f\" JOIN \"main\".\"dim_line\" AS \"dim_line\" ON \"f\".\"line_code\" = \"dim_line\".\"line_code\" GROUP BY \"dim_line\".\"line_name\" HAVING (COUNT(*) + COUNT(*)) > 0 ORDER BY \"energy_per_thousand_good_units\" DESC LIMIT 10000",
    "step_id": "st1",
    "columns": [
      {
        "name": "line_name",
        "label": "line name",
        "type": "nominal",
        "role": "dimension",
        "unit": null,
        "format": null,
        "description": "Production line, e.g. Brno welding."
      },
      {
        "name": "energy_per_thousand_good_units",
