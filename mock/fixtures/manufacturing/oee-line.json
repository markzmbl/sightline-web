        "role": "answer",
        "ms": 140,
        "verdict": null,
        "cached": true,
        "sql": "SELECT \"dim_equipment\".\"line_name\" AS \"line_name\", (100 * ((((COALESCE(SUM(\"f\".\"run_minutes\" / 60.0), 0))) / NULLIF((COALESCE(SUM(\"f\".\"planned_busy_minutes\" / 60.0), 0)), 0))) * ((((COALESCE(SUM(\"f\".\"ideal_minutes\" / 60.0), 0))) / NULLIF((COALESCE(SUM(\"f\".\"run_minutes\" / 60.0), 0)), 0))) * ((((COALESCE(SUM(\"f\".\"good_qty\"), 0))) / NULLIF((COALESCE(SUM(\"f\".\"produced_qty\"), 0)), 0)))) AS \"oee\" FROM \"main\".\"fct_production_shifts\" AS \"f\" JOIN \"main\".\"dim_equipment\" AS \"dim_equipment\" ON \"f\".\"equipment_code\" = \"dim_equipment\".\"equipment_code\" WHERE \"f\".\"shift_date\" >= CAST('2025-12-22' AS DATE) AND \"f\".\"shift_date\" <= CAST('2025-12-28' AS DATE) GROUP BY \"dim_equipment\".\"line_name\" HAVING (COUNT(*) + COUNT(*) + COUNT(*) + COUNT(*) + COUNT(*)) > 0 ORDER BY \"oee\" DESC LIMIT 10000",
