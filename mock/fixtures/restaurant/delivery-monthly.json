  "result": {
    "sql": "SELECT DATE_TRUNC('MONTH', \"f\".\"date_key\") AS \"month\", SUM(\"f\".\"line_revenue\") AS \"line_revenue\" FROM \"fact_order_lines\" AS \"f\" JOIN \"dim_channel\" AS \"dim_channel\" ON \"f\".\"channel_key\" = \"dim_channel\".\"channel_key\" WHERE \"dim_channel\".\"channel_name\" = 'delivery' AND \"f\".\"date_key\" >= CAST('2025-01-01' AS DATE) AND \"f\".\"date_key\" <= CAST('2025-12-31' AS DATE) GROUP BY DATE_TRUNC('MONTH', \"f\".\"date_key\") ORDER BY \"month\" ASC LIMIT 10000",
