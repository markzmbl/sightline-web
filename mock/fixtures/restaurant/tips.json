    "sql": "SELECT \"f\".\"payment_method\" AS \"payment_method\", AVG(\"f\".\"tip_amount\") AS \"tip_amount\" FROM \"fact_payments\" AS \"f\" GROUP BY \"f\".\"payment_method\" ORDER BY \"tip_amount\" DESC LIMIT 10000",
